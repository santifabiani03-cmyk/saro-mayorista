{
  "headers": [
    {
      "source": "/assets/(.*)\\.mjs",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/assets/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/api/(.*)",    "destination": "/api/$1" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}
